@model IEnumerable<AdminUserViewModel>

<h1>Manage Users</h1>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Roles</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.Roles</td>
                <td>
                    <form asp-action="Ban" method="post">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <button class="btn btn-danger">Ban</button>
                    </form>
                    <form asp-action="AssignRole" method="post">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <input type="text" name="roleName" placeholder="Role" />
                        <button class="btn btn-primary">Assign Role</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

